# ViFood-KC: Neo4j SOURCE, chỉ dùng để đọc dữ liệu gốc.
SOURCE_NEO4J_URI=bolt://localhost:7687
SOURCE_NEO4J_USER=neo4j
SOURCE_NEO4J_PASSWORD=password
SOURCE_NEO4J_DATABASE=neo4j

# ViFood-KG: Neo4j TARGET, dùng để match/create/import graph runtime.
TARGET_NEO4J_URI=bolt://localhost:7688
TARGET_NEO4J_USER=neo4j
TARGET_NEO4J_PASSWORD=password
TARGET_NEO4J_DATABASE=neo4j

# ViFood-KG Builder Contract.
# Local example:
# KG_CONTRACT_PATH=/Users/ltthanh/LtThanh/KLTN/ViFood-KG/data/contracts/kg_schema_contract.json
# VPS example:
# KG_CONTRACT_PATH=/opt/vifood/contracts/kg_schema_contract.json
KG_CONTRACT_PATH=path
KG_CONTRACT_VERSION=version

# Optional graph labels.
INGREDIENT_LABEL=Ingredient
ADDITIVE_LABEL=Additive
NUTRIENT_LABEL=Nutrient
SOURCE_LABEL=Source
REGULATION_LABEL=Regulation

# Runtime API: Builder nhận payload ảnh từ ViFood-API, gọi KIE model qua HTTP local,
# sau đó match/link bằng Target Neo4j.
KIE_MODEL_URL=http://localhost:8001
KIE_MODEL_TIMEOUT_SECONDS=90

# Wikidata Ingredient flow.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIDATA_ENTITY_BASE_URL=https://www.wikidata.org/wiki
WIKIDATA_SOURCE_ID=SOURCE:WIKIDATA
WIKIDATA_SOURCE_NAME=Wikidata
WIKIDATA_SOURCE_URL=https://www.wikidata.org/
WIKIDATA_USER_AGENT=ViFood-KG-Builder/1.0 (https://github.com/ViFood/NutriQuor; educational research)
WIKIDATA_SEARCH_LANGUAGE=vi
WIKIDATA_SEARCH_LIMIT=10
WIKIDATA_REQUEST_TIMEOUT_SECONDS=30
WIKIDATA_DETAIL_TIMEOUT_SECONDS=45
WIKIDATA_FOOD_SIGNAL_QIDS=Q2095,Q25403900,Q189567,Q19861951,Q193598,Q40050,Q11004,Q59199015

OPENAI_API_KEY=your_openai_api_key
MODEL=gpt-4o-mini
